---
const { color = '#0076ff' } = Astro.props;
---

<button id="scroll-to-bottom" class="floating-btn" aria-label="Rolar para o final">
  <span class="arrow">↓</span>
</button>

<script>
  const scrollBtn = document.getElementById('scroll-to-bottom')!;

  function checkScrollPosition() {
    const currentScroll = window.scrollY; // Quanto o usuário já rolou
    const windowHeight = window.innerHeight; // Altura da janela visível
    const fullHeight = document.documentElement.scrollHeight; // Altura total da página completa

    if ((currentScroll + windowHeight) >= (fullHeight - 50)) {
      // Chegou no final: esconde o botão
      scrollBtn.classList.add('hidden');
    } else {
      // Não está no final: mostra o botão
      scrollBtn.classList.remove('hidden');
    }
  }

  // Lógica para realmente rolar para o final ao clicar
  scrollBtn.addEventListener('click', () => {
    window.scrollTo({
      top: document.documentElement.scrollHeight,
      behavior: 'smooth' // Rolar suavemente
    });
  });

  // Executa a função sempre que o usuário rolar a página
  window.addEventListener('scroll', checkScrollPosition);
  
  // Executa uma vez ao carregar a página para definir o estado inicial
  checkScrollPosition();
</script>

<style define:vars={{ color }}>
  
  .floating-btn {
    position: fixed; /* Fixa o botão na tela, independentemente da rolagem */
    bottom: 20px;     /* Distância do fundo */
    right: 20px;      /* Distância da direita */
    background-color: var(--color); /* Usa a cor passada por propriedade */
    color: white;
    border: none;
    border-radius: 50%; /* Faz o botão ser redondo */
    width: 50px;
    height: 50px;
    font-size: 24px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); /* Sombra para dar profundidade */
    
    /* Animação suave para aparecer/desaparecer */
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    
    /* Garante que fique acima de outros conteúdos */
    z-index: 1000; 

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .floating-btn:hover {
    transform: scale(1.1); /* Efeito de aumentar ligeiramente ao passar o mouse */
  }

  /* Classe que esconde o botão */
  .floating-btn.hidden {
    opacity: 0;           /* Torna invisível */
    visibility: hidden;   /* Impede que seja clicado */
    transform: translateY(20px); /* Move ligeiramente para baixo ao sumir */
  }

  .arrow {
    display: inline-block;
    transform: translateY(-2px); /* Ajuste fino da posição da seta */
  }
</style>