---
import ScrollToBottom from '../components/ScrollToBottom.astro';
const { frontmatter } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{frontmatter.title} | Meu Portfólio</title>
    <meta name="description" content={frontmatter.description}>
    <style>
        /* Um estilo bem simples e limpo apenas para visualização */
        body {
            font-family: sans-serif;
            max-width: 700px;
            margin: 40px auto;
            padding: 0 20px;
            line-height: 1.6;
            color: #333;
        }
        a { color: #0076ff; text-decoration: none; }
        .voltar { display: block; margin-bottom: 20px; }
        .tag { background: #f0f0f0; padding: 4px 8px; border-radius: 4px; font-size: 0.9em; margin-right: 5px; }
    </style>
</head>
<body>
    <a href="/portfolio" class="voltar">← Voltar para a Home</a>
    
    <header>
        <h1>{frontmatter.title}</h1>

        {frontmatter.image && (
            <img 
                src={frontmatter.image} 
                alt={`Capa do projeto ${frontmatter.title}`} 
                style="width: 100%; height: auto; border-radius: 12px; margin-bottom: 20px; object-fit: cover; max-height: 300px; border: 1px solid #eee;"
            />
        )}
        
        <p style="color: #666; font-style: italic;">{frontmatter.description}</p>
        <div>
            {frontmatter.tags.map((tag: unknown) => <span class="tag">{tag}</span>)}
        </div>
    </header>

    <hr style="margin: 30px 0; border: 0; border-top: 1px solid #eee;" />

    <main>
        <slot />
    </main>

    <ScrollToBottom />
</body>
</html>